{
  "name": "@file-preview/plugin-pdf",
  "version": "0.3.0",
  "type": "module",
  "description": "PDF preview plugin for @file-preview/core (pdfjs-dist, lazy-loaded)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "files": [
      "dist"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/apply-publish-manifest.mjs apply",
    "postpack": "node ../../scripts/apply-publish-manifest.mjs restore"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "peerDependencies": {
    "@file-preview/core": "^0.3.0"
  },
  "devDependencies": {
    "@file-preview/core": "*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "contractVersion": 1
}
