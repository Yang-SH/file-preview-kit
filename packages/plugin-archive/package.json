{
    "name":  "@file-preview/plugin-archive",
    "version":  "0.3.1",
    "type":  "module",
    "description":  "Archive (zip) preview plugin for @file-preview/core with bomb-guard limits",
    "main":  "./src/index.ts",
    "types":  "./src/index.ts",
    "exports":  {
                    ".":  {
                              "types":  "./src/index.ts",
                              "import":  "./src/index.ts",
                              "default":  "./src/index.ts"
                          }
                },
    "publishConfig":  {
                          "main":  "./dist/index.cjs",
                          "module":  "./dist/index.js",
                          "types":  "./dist/index.d.ts",
                          "exports":  {
                                          ".":  {
                                                    "types":  "./dist/index.d.ts",
                                                    "import":  "./dist/index.js",
                                                    "require":  "./dist/index.cjs"
                                                }
                                      },
                          "files":  [
                                        "dist"
                                    ]
                      },
    "sideEffects":  false,
    "scripts":  {
                    "build":  "tsup",
                    "typecheck":  "tsc --noEmit",
                    "prepack":  "node ../../scripts/apply-publish-manifest.mjs apply",
                    "postpack":  "node ../../scripts/apply-publish-manifest.mjs restore"
                },
    "dependencies":  {
                         "fflate":  "^0.8.2"
                     },
    "peerDependencies":  {
                             "@file-preview/core":  "^0.4.0"
                         },
    "devDependencies":  {
                            "@file-preview/core":  "*",
                            "@types/node":  "^22.10.2",
                            "tsup":  "^8.3.5",
                            "typescript":  "^5.7.2"
                        },
    "license":  "MIT",
    "contractVersion":  1
}