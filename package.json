{
  "name": "file-preview-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isomorphic file-preview component library (monorepo root)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "smoke": "node --experimental-strip-types packages/core/examples/node-ssr/smoke.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.0",
    "papaparse": "^5.6.0"
  }
}
